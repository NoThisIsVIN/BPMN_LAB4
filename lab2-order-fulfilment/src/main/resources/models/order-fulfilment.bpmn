<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_order-fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_order-fulfilment">
    <bpmn:participant id="Participant_order-fulfilment" name="E-Commerce Order Processing &amp; Fulfilment (educational scenario)" processRef="order-fulfilment" />
  </bpmn:collaboration>
  <bpmn:process id="order-fulfilment" name="Order Fulfilment" isExecutable="true">
    <bpmn:documentation>Validates an order, reserves stock (primary warehouse, falling back to a secondary one), calculates the total, determines delivery priority (DMN), verifies high-value/exception orders in Tasklist, charges the primary payment provider (falling back to a backup provider) via REST connectors, lets the customer try another payment method after a decline, and books the shipment (primary carrier, falling back to a backup carrier). Synthetic data and mock payment tokens only.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_order-fulfilment">
      <bpmn:lane id="Lane_OrderSystem" name="Order system (automated)">
        <bpmn:flowNodeRef>StartEvent_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPrimaryWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrimaryStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSecondaryWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SecondaryStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateTotal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeterminePriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VerificationRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinPaymentAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChargePrimary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_PrimaryProviderDown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChargeBackup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinPaymentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookPrimaryCarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CarrierUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookBackupCarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderFulfilled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryAllowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskNewPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_NoNewPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCancelPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseStockPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyPaymentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PaymentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyOutOfStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OutOfStock</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OrderReviewer" name="Order reviewer">
        <bpmn:flowNodeRef>Task_VerifyOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseStockReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCancelledReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CancelledByReviewer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Order placed">
      <bpmn:documentation>Instance variables: orderId, customerReference, productId, quantity, deliveryPreference (STANDARD | EXPRESS | SAME_DAY), paymentToken (mock token, e.g. tok_test_approve). Optional: paymentRetryTimeout (ISO-8601 duration, default PT30M), maxPaymentAttempts (default 2).</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate order">
      <bpmn:documentation>Java job worker. Checks mandatory fields, looks up the synthetic customer (-&gt; customerCategory) and product (-&gt; productName, unitPrice), quantity 1-100, delivery preference and token format. Sets the payment-retry defaults (paymentAttempts = 1, maxPaymentAttempts, paymentRetryTimeout).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.validate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OrderValid" name="Order valid?" default="Flow_Valid_No">
      <bpmn:incoming>Flow_Validate_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckPrimaryWarehouse" name="Check inventory – primary warehouse">
      <bpmn:documentation>Java job worker against the simulated inventory service, warehouse WH-CENTRAL. Reserves the quantity when available. Fault 'inventory-service-down' -&gt; retries with 5 s back-off -&gt; incident.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.check-inventory" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="warehouse" value="PRIMARY" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Primary_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PrimaryStock" name="In stock at primary warehouse?" default="Flow_Primary_No">
      <bpmn:incoming>Flow_Primary_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Primary_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Primary_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckSecondaryWarehouse" name="Check inventory – secondary warehouse">
      <bpmn:documentation>Fallback: same worker, warehouse WH-REGIONAL. Reserves there when the primary warehouse is short.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.check-inventory" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="warehouse" value="SECONDARY" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Primary_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Secondary_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SecondaryStock" name="In stock at secondary warehouse?" default="Flow_Secondary_No">
      <bpmn:incoming>Flow_Secondary_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Secondary_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Secondary_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinStock">
      <bpmn:incoming>Flow_Primary_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Secondary_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinStock_Total</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CalculateTotal" name="Calculate order total">
      <bpmn:documentation>Java job worker. subtotal, discount (VIP 10%), shipping fee, VAT 20% -&gt; orderTotal (EUR).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.calculate-total" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinStock_Total</bpmn:incoming>
      <bpmn:outgoing>Flow_Total_Priority</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_DeterminePriority" name="Determine delivery priority">
      <bpmn:documentation>Business rule task -&gt; DMN 'order-priority' (hit policy FIRST) on orderTotal, customerCategory and deliveryPreference.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order-priority" resultVariable="priorityDecision" />
        <zeebe:ioMapping>
        <zeebe:output source="=priorityDecision" target="priorityDecision" />
        <zeebe:output source="=priorityDecision.deliveryPriority" target="deliveryPriority" />
        <zeebe:output source="=priorityDecision.slaHours" target="slaHours" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Total_Priority</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_Gw</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_VerificationRequired" name="Manual verification required?" default="Flow_Verification_No">
      <bpmn:incoming>Flow_Priority_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Verification_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Verification_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinVerified">
      <bpmn:incoming>Flow_Verification_No</bpmn:incoming>
      <bpmn:incoming>Flow_Verified_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinVerified_Attempt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinPaymentAttempt">
      <bpmn:incoming>Flow_JoinVerified_Attempt</bpmn:incoming>
      <bpmn:incoming>Flow_NewMethod_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_Attempt_Primary</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ChargePrimary" name="Charge payment – primary provider" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST Outbound Connector -&gt; POST /mock/payment-gateway/primary/charges. Declines are HTTP 200 with status DECLINED (a business answer). HTTP 5xx / 408 timeout of the provider is mapped to BPMN error PAYMENT_PROVIDER_DOWN -&gt; the backup provider is used.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="POST" target="method" />
        <zeebe:input source="http://localhost:8082/mock/payment-gateway/primary/charges" target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="5" target="readTimeoutInSeconds" />
        <zeebe:input source="={orderId: orderId, amount: orderTotal, currency: currency, paymentToken: paymentToken, customerReference: customerReference}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value="={paymentStatus: response.body.status, transactionId: response.body.transactionId, declineReason: response.body.declineReason, paymentProvider: response.body.provider}" />
        <zeebe:header key="errorExpression" value='=if error != null and (string(error.code) = "408" or starts with(string(error.code), "5")) then bpmnError("PAYMENT_PROVIDER_DOWN", "Primary payment provider unavailable", {primaryPaymentError: "HTTP " + string(error.code) + ": " + (if error.variables.response.body.error != null then string(error.variables.response.body.error) else string(error.message))}) else null' />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Attempt_Primary</bpmn:incoming>
      <bpmn:outgoing>Flow_Primary_Result</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_PrimaryProviderDown" name="Provider down" attachedToRef="Task_ChargePrimary">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
        <zeebe:output source="=true" target="paymentFallbackUsed" />
        <zeebe:output source="=primaryPaymentError" target="primaryPaymentError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ProviderDown_Backup</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Error_PaymentProviderDown_def" errorRef="Error_PaymentProviderDown" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ChargeBackup" name="Charge payment – backup provider" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST Outbound Connector -&gt; POST /mock/payment-gateway/backup/charges. No error expression on purpose: if the backup provider is down too, the job is retried 3 times (5 s back-off) and then an incident is raised for an operator.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="POST" target="method" />
        <zeebe:input source="http://localhost:8082/mock/payment-gateway/backup/charges" target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="10" target="readTimeoutInSeconds" />
        <zeebe:input source="={orderId: orderId, amount: orderTotal, currency: currency, paymentToken: paymentToken, customerReference: customerReference}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value="={paymentStatus: response.body.status, transactionId: response.body.transactionId, declineReason: response.body.declineReason, paymentProvider: response.body.provider}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProviderDown_Backup</bpmn:incoming>
      <bpmn:outgoing>Flow_Backup_Result</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_JoinPaymentResult">
      <bpmn:incoming>Flow_Primary_Result</bpmn:incoming>
      <bpmn:incoming>Flow_Backup_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Result_Gw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PaymentApproved" name="Payment approved?" default="Flow_Payment_No">
      <bpmn:incoming>Flow_Result_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Payment_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BookPrimaryCarrier" name="Book shipment – primary carrier">
      <bpmn:documentation>Java job worker. Commits the stock reservation and books the primary carrier (service level from the DMN priority). Fault 'primary-carrier-down' -&gt; BPMN error CARRIER_UNAVAILABLE.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.book-shipment" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="carrier" value="PRIMARY" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Payment_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_PrimaryCarrier_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CarrierUnavailable" name="Carrier unavailable" attachedToRef="Task_BookPrimaryCarrier">
      <bpmn:outgoing>Flow_CarrierDown_Backup</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Error_CarrierUnavailable_def" errorRef="Error_CarrierUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_BookBackupCarrier" name="Book shipment – backup carrier">
      <bpmn:documentation>Fallback carrier: same worker with carrier = BACKUP.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.book-shipment" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="carrier" value="BACKUP" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CarrierDown_Backup</bpmn:incoming>
      <bpmn:outgoing>Flow_BackupCarrier_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_JoinShipment">
      <bpmn:incoming>Flow_PrimaryCarrier_Join</bpmn:incoming>
      <bpmn:incoming>Flow_BackupCarrier_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Shipment_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyConfirmed" name="Send order confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.notify-customer" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="ORDER_CONFIRMED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Shipment_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_OrderFulfilled" name="Order sent to fulfilment">
      <bpmn:incoming>Flow_Confirmed_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyInvalid" name="Notify customer: order rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.notify-customer" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="ORDER_INVALID" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid_No</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyInvalid_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order rejected – invalid order">
      <bpmn:incoming>Flow_NotifyInvalid_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_RetryAllowed" name="Another payment attempt allowed?" default="Flow_Retry_No">
      <bpmn:incoming>Flow_Payment_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_AskNewPaymentMethod" name="Ask customer for another payment method">
      <bpmn:documentation>Java job worker: tells the customer the card was declined and counts the attempt (paymentAttempts + 1).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.request-payment-method" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Retry_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Ask_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_WaitForPaymentMethod" name="Wait for new payment method" messageRef="Message_PaymentMethodUpdated">
      <bpmn:documentation>Receive task: waits for message 'payment-method-updated' (correlation key = orderId) carrying a new mock paymentToken. Interrupting timer = paymentRetryTimeout (default PT30M).</bpmn:documentation>
      <bpmn:incoming>Flow_Ask_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_NewMethod_Loop</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_NoNewPaymentMethod" name="No reply in time" attachedToRef="Task_WaitForPaymentMethod">
      <bpmn:outgoing>Flow_Timeout_Cancel</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=paymentRetryTimeout</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinCancelPayment">
      <bpmn:incoming>Flow_Retry_No</bpmn:incoming>
      <bpmn:incoming>Flow_Timeout_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_Release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleaseStockPayment" name="Release reserved stock">
      <bpmn:documentation>Compensation: returns the reserved quantity to the warehouse it was reserved in.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.release-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cancel_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_Release_NotifyDeclined</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyPaymentDeclined" name="Notify customer: payment declined">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.notify-customer" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="PAYMENT_DECLINED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Release_NotifyDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyDeclined_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_PaymentDeclined" name="Order cancelled – payment declined">
      <bpmn:incoming>Flow_NotifyDeclined_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyOutOfStock" name="Notify customer: out of stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.notify-customer" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="OUT_OF_STOCK" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Secondary_No</bpmn:incoming>
      <bpmn:outgoing>Flow_OutOfStock_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_OutOfStock" name="Order cancelled – insufficient stock">
      <bpmn:incoming>Flow_OutOfStock_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_VerifyOrder" name="Verify high-value order">
      <bpmn:documentation>Camunda user task (Tasklist), candidate group order-reviewers. Form: order-verification-form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="order-verification-form" />
        <zeebe:assignmentDefinition candidateGroups="order-reviewers" />
        <zeebe:priorityDefinition priority="70" />
        <zeebe:ioMapping>
        <zeebe:output source="=verificationDecision" target="verificationDecision" />
        <zeebe:output source="=verificationComment" target="verificationComment" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verification_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OrderVerified" name="Order verified?" default="Flow_Verified_No">
      <bpmn:incoming>Flow_Verify_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Verified_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Verified_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleaseStockReview" name="Release reserved stock">
      <bpmn:documentation>Compensation: returns the reserved quantity to the warehouse it was reserved in.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.release-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verified_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseReview_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyCancelledReview" name="Notify customer: order cancelled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.notify-customer" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="CANCELLED_BY_REVIEW" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReleaseReview_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyCancelled_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_CancelledByReviewer" name="Order cancelled by reviewer">
      <bpmn:incoming>Flow_NotifyCancelled_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartEvent_OrderPlaced" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Validate_Gw" sourceRef="Task_ValidateOrder" targetRef="Gateway_OrderValid" />
    <bpmn:sequenceFlow id="Flow_Valid_Yes" sourceRef="Gateway_OrderValid" targetRef="Task_CheckPrimaryWarehouse" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid_No" sourceRef="Gateway_OrderValid" targetRef="Task_NotifyInvalid" name="No" />
    <bpmn:sequenceFlow id="Flow_NotifyInvalid_End" sourceRef="Task_NotifyInvalid" targetRef="EndEvent_OrderRejected" />
    <bpmn:sequenceFlow id="Flow_Primary_Gw" sourceRef="Task_CheckPrimaryWarehouse" targetRef="Gateway_PrimaryStock" />
    <bpmn:sequenceFlow id="Flow_Primary_Yes" sourceRef="Gateway_PrimaryStock" targetRef="Gateway_JoinStock" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Primary_No" sourceRef="Gateway_PrimaryStock" targetRef="Task_CheckSecondaryWarehouse" name="No – try secondary" />
    <bpmn:sequenceFlow id="Flow_Secondary_Gw" sourceRef="Task_CheckSecondaryWarehouse" targetRef="Gateway_SecondaryStock" />
    <bpmn:sequenceFlow id="Flow_Secondary_Yes" sourceRef="Gateway_SecondaryStock" targetRef="Gateway_JoinStock" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Secondary_No" sourceRef="Gateway_SecondaryStock" targetRef="Task_NotifyOutOfStock" name="No" />
    <bpmn:sequenceFlow id="Flow_OutOfStock_End" sourceRef="Task_NotifyOutOfStock" targetRef="EndEvent_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_JoinStock_Total" sourceRef="Gateway_JoinStock" targetRef="Task_CalculateTotal" />
    <bpmn:sequenceFlow id="Flow_Total_Priority" sourceRef="Task_CalculateTotal" targetRef="Task_DeterminePriority" />
    <bpmn:sequenceFlow id="Flow_Priority_Gw" sourceRef="Task_DeterminePriority" targetRef="Gateway_VerificationRequired" />
    <bpmn:sequenceFlow id="Flow_Verification_No" sourceRef="Gateway_VerificationRequired" targetRef="Gateway_JoinVerified" name="No" />
    <bpmn:sequenceFlow id="Flow_Verification_Yes" sourceRef="Gateway_VerificationRequired" targetRef="Task_VerifyOrder" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 2000 or (customerCategory = "NEW" and orderTotal &gt;= 1000)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verify_Gw" sourceRef="Task_VerifyOrder" targetRef="Gateway_OrderVerified" />
    <bpmn:sequenceFlow id="Flow_Verified_Yes" sourceRef="Gateway_OrderVerified" targetRef="Gateway_JoinVerified" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verified_No" sourceRef="Gateway_OrderVerified" targetRef="Task_ReleaseStockReview" name="No" />
    <bpmn:sequenceFlow id="Flow_ReleaseReview_Notify" sourceRef="Task_ReleaseStockReview" targetRef="Task_NotifyCancelledReview" />
    <bpmn:sequenceFlow id="Flow_NotifyCancelled_End" sourceRef="Task_NotifyCancelledReview" targetRef="EndEvent_CancelledByReviewer" />
    <bpmn:sequenceFlow id="Flow_JoinVerified_Attempt" sourceRef="Gateway_JoinVerified" targetRef="Gateway_JoinPaymentAttempt" />
    <bpmn:sequenceFlow id="Flow_Attempt_Primary" sourceRef="Gateway_JoinPaymentAttempt" targetRef="Task_ChargePrimary" />
    <bpmn:sequenceFlow id="Flow_Primary_Result" sourceRef="Task_ChargePrimary" targetRef="Gateway_JoinPaymentResult" />
    <bpmn:sequenceFlow id="Flow_ProviderDown_Backup" sourceRef="Boundary_PrimaryProviderDown" targetRef="Task_ChargeBackup" />
    <bpmn:sequenceFlow id="Flow_Backup_Result" sourceRef="Task_ChargeBackup" targetRef="Gateway_JoinPaymentResult" />
    <bpmn:sequenceFlow id="Flow_Result_Gw" sourceRef="Gateway_JoinPaymentResult" targetRef="Gateway_PaymentApproved" />
    <bpmn:sequenceFlow id="Flow_Payment_Yes" sourceRef="Gateway_PaymentApproved" targetRef="Task_BookPrimaryCarrier" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Payment_No" sourceRef="Gateway_PaymentApproved" targetRef="Gateway_RetryAllowed" name="Declined" />
    <bpmn:sequenceFlow id="Flow_Retry_Yes" sourceRef="Gateway_RetryAllowed" targetRef="Task_AskNewPaymentMethod" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentAttempts &lt; maxPaymentAttempts</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Retry_No" sourceRef="Gateway_RetryAllowed" targetRef="Gateway_JoinCancelPayment" name="No" />
    <bpmn:sequenceFlow id="Flow_Ask_Wait" sourceRef="Task_AskNewPaymentMethod" targetRef="Task_WaitForPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_NewMethod_Loop" sourceRef="Task_WaitForPaymentMethod" targetRef="Gateway_JoinPaymentAttempt" name="New payment method" />
    <bpmn:sequenceFlow id="Flow_Timeout_Cancel" sourceRef="Boundary_NoNewPaymentMethod" targetRef="Gateway_JoinCancelPayment" />
    <bpmn:sequenceFlow id="Flow_Cancel_Release" sourceRef="Gateway_JoinCancelPayment" targetRef="Task_ReleaseStockPayment" />
    <bpmn:sequenceFlow id="Flow_Release_NotifyDeclined" sourceRef="Task_ReleaseStockPayment" targetRef="Task_NotifyPaymentDeclined" />
    <bpmn:sequenceFlow id="Flow_NotifyDeclined_End" sourceRef="Task_NotifyPaymentDeclined" targetRef="EndEvent_PaymentDeclined" />
    <bpmn:sequenceFlow id="Flow_PrimaryCarrier_Join" sourceRef="Task_BookPrimaryCarrier" targetRef="Gateway_JoinShipment" />
    <bpmn:sequenceFlow id="Flow_CarrierDown_Backup" sourceRef="Boundary_CarrierUnavailable" targetRef="Task_BookBackupCarrier" />
    <bpmn:sequenceFlow id="Flow_BackupCarrier_Join" sourceRef="Task_BookBackupCarrier" targetRef="Gateway_JoinShipment" />
    <bpmn:sequenceFlow id="Flow_Shipment_Notify" sourceRef="Gateway_JoinShipment" targetRef="Task_NotifyConfirmed" />
    <bpmn:sequenceFlow id="Flow_Confirmed_End" sourceRef="Task_NotifyConfirmed" targetRef="EndEvent_OrderFulfilled" />
    <bpmn:textAnnotation id="Annotation_StockFallback">
      <bpmn:text>Stock fallback:
primary warehouse WH-CENTRAL
→ secondary warehouse WH-REGIONAL
→ cancel only if both are short</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_VerificationRule">
      <bpmn:text>Manual verification when:
• total ≥ 2 000 (high value), or
• NEW customer and total ≥ 1 000</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_PaymentFallback">
      <bpmn:text>Primary provider HTTP 5xx / timeout
→ BPMN error → backup provider.
Backup also down → 3 attempts, 5 s back-off
→ incident (restore, then retry in Operate)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_DeclineRetry">
      <bpmn:text>Card declined → customer may send another payment
method (message payment-method-updated, max 2
attempts). No reply within paymentRetryTimeout
(default 30 min) → stock released, order cancelled.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_CarrierFallback">
      <bpmn:text>Primary carrier booking API down
→ BPMN error CARRIER_UNAVAILABLE
→ backup carrier</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_DmnRules">
      <bpmn:text>DMN order-priority (FIRST hit):
• SAME_DAY → CRITICAL (8 h)
• EXPRESS + VIP → CRITICAL (12 h)
• EXPRESS → HIGH (24 h)
• VIP → HIGH (24 h)
• STANDARD, total ≥ 500 → NORMAL (48 h)
• STANDARD, total &lt; 500 → LOW (96 h)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Legend">
      <bpmn:text>Legend
green task = Java job worker
blue task = REST connector
purple task = DMN decision
orange task = human task (Tasklist)
teal task = waiting for the customer's reply
grey task = notification</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:error id="Error_PaymentProviderDown" name="Payment provider unavailable" errorCode="PAYMENT_PROVIDER_DOWN" />
  <bpmn:error id="Error_CarrierUnavailable" name="Carrier unavailable" errorCode="CARRIER_UNAVAILABLE" />
  <bpmn:message id="Message_PaymentMethodUpdated" name="payment-method-updated">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>

{
  "id": "L2-07",
  "title": "Payment gateway outage → incident → gateway restored → retry → fulfilled",
  "category": "failure-recovery",
  "processId": "order-fulfilment",
  "app": "http://localhost:8082",
  "expected": {
    "endEvent": "EndEvent_OrderFulfilled",
    "route": "… → Process payment fails (HTTP 503) 3× → incident → fault off → retry job → APPROVED → fulfilment"
  },
  "variables": {
    "orderId": "ORD-2007",
    "customerReference": "CUST-0001",
    "productId": "PRD-4004",
    "quantity": 1,
    "deliveryPreference": "EXPRESS",
    "paymentToken": "tok_test_approve"
  },
  "steps": [
    {
      "do": "fault",
      "name": "payment-gateway-down",
      "enabled": true,
      "before": true
    },
    {
      "do": "expectIncident",
      "elementId": "Task_ProcessPayment",
      "timeout": 120
    },
    {
      "do": "screenshot",
      "view": "operate-instance",
      "name": "07-operate-incident"
    },
    {
      "do": "screenshot",
      "view": "operate-incidents",
      "name": "08-operate-incident-detail"
    },
    {
      "do": "fault",
      "name": "payment-gateway-down",
      "enabled": false
    },
    {
      "do": "retryIncident"
    },
    {
      "do": "wait"
    },
    {
      "do": "screenshot",
      "view": "operate-instance",
      "name": "09-operate-recovered"
    }
  ],
  "reportVariables": [
    "orderValid",
    "validationErrors",
    "customerCategory",
    "stockStatus",
    "reservationId",
    "reservationStatus",
    "orderTotal",
    "deliveryPriority",
    "slaHours",
    "verificationDecision",
    "paymentStatus",
    "transactionId",
    "declineReason",
    "shipmentId",
    "trackingNumber"
  ]
}

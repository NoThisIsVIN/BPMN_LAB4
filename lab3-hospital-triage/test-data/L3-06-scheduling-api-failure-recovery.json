{
  "id": "L3-06",
  "title": "Scheduling API down → incident → service restored → retried → booked → confirmed",
  "category": "failure-recovery",
  "processId": "patient-appointment-triage",
  "app": "http://localhost:8083",
  "expected": {
    "endEvent": "EndEvent_AppointmentConfirmed",
    "route": "Retrieve slots fails 3x (HTTP 503) → INCIDENT → fault off → job retried → booked → confirmed"
  },
  "variables": {
    "patientReference": "SYN-P-0106",
    "patientAge": 45,
    "appointmentPreference": {
      "department": "RESPIRATORY",
      "preferredDate": "2026-11-03",
      "timeOfDay": "ANY"
    },
    "symptomsSummary": "Persistent wheeze in the mornings",
    "painLevel": 3,
    "symptomDurationDays": 6
  },
  "steps": [
    {
      "do": "fault",
      "name": "scheduling-api-down",
      "enabled": true,
      "before": true
    },
    {
      "do": "expectIncident",
      "elementId": "Task_RetrieveSlots",
      "timeout": 150
    },
    {
      "do": "screenshot",
      "view": "operate-instance",
      "name": "07-operate-incident"
    },
    {
      "do": "screenshot",
      "view": "operate-incident",
      "name": "08-operate-incident-detail"
    },
    {
      "do": "screenshot",
      "view": "operate-incident-message",
      "name": "08-operate-incident-message"
    },
    {
      "do": "fault",
      "name": "scheduling-api-down",
      "enabled": false
    },
    {
      "do": "retryIncident"
    },
    {
      "do": "publishMessage",
      "name": "appointment-confirmed",
      "correlationKey": "SYN-P-0106",
      "waitForElement": "Task_WaitForConfirmation",
      "variables": {
        "confirmedVia": "SMS reply (synthetic)"
      }
    },
    {
      "do": "waitForElement",
      "elementId": "EndEvent_AppointmentConfirmed",
      "state": "COMPLETED"
    },
    {
      "do": "screenshot",
      "view": "operate-instance",
      "name": "09-operate-recovered"
    },
    {
      "do": "screenshot",
      "view": "operate-variables",
      "name": "10-operate-variables"
    }
  ],
  "reportVariables": [
    "urgencyCategory",
    "triageReason",
    "maxWaitDays",
    "registrationErrors",
    "reviewOutcome",
    "assessmentOutcome",
    "schedulingOutcome",
    "searchSite",
    "slotCount",
    "firstAttemptConflicts",
    "requeried",
    "bookingStatus",
    "bookingReference",
    "bookingSite",
    "appointmentSlot",
    "patientConfirmation"
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_patient-appointment-triage" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_patient-appointment-triage">
    <bpmn:participant id="Participant_patient-appointment-triage" name="Hospital Appointment &amp; Patient Triage (synthetic educational scenario)" processRef="patient-appointment-triage" />
  </bpmn:collaboration>
  <bpmn:process id="patient-appointment-triage" name="Patient Appointment &amp; Triage" isExecutable="true">
    <bpmn:documentation>Registers a synthetic appointment request, classifies it with educational triage rules (DMN), routes priority/urgent cases to clinical staff in Tasklist, retrieves slots from a mock scheduling API via the REST Connector (falling back to a partner clinic and re-querying when a slot is taken), books the appointment and waits for the patient's confirmation. Not clinical guidance; synthetic data only.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_patient-appointment-triage">
      <bpmn:lane id="Lane_SchedulingStaff" name="Scheduling staff">
        <bpmn:flowNodeRef>Gateway_JoinStaffNoSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinStaffTaken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveScheduling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SchedulingOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyWaitlisted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Waitlisted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppointmentSystem" name="Appointment system (automated)">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RegistrationComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyTriage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UrgentNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PriorityNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SlotAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinSlotFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_SlotTaken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinBooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinManualSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ConfirmationReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ConfirmationTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AppointmentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMissingDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPartnerClinic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequerySlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FreeSlotFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookRequeriedSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_SlotTakenAgain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReleased</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SlotReleased</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClinicalStaff" name="Clinical staff">
        <bpmn:flowNodeRef>Task_PriorityReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UrgentAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_NotPickedUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssessmentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOverED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EmergencyReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateDutyManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DutyManagerAlerted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Appointment request received">
      <bpmn:documentation>Variables: patientReference (SYN-P-####), patientAge, appointmentPreference {department, preferredDate, timeOfDay}, symptomsSummary, painLevel, chestPain, breathingDifficulty, highFever, symptomDurationDays, chronicCondition. Optional timer overrides: urgentEscalationAfter, confirmationReminderAfter, confirmationTimeout (ISO-8601 durations).</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate registration">
      <bpmn:documentation>Java job worker. Checks mandatory registration fields and value ranges, normalises urgency indicators (missing flags -&gt; false), flattens the appointment preference and sets the timer defaults (PT15M / PT12H / PT24H) when they were not supplied. Outputs registrationValid, registrationErrors, department, preferredDate, timeOfDay.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.validate-registration" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RegistrationComplete" name="Registration complete?" default="Flow_Registration_No">
      <bpmn:incoming>Flow_Validate_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Registration_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Registration_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ClassifyTriage" name="Classify triage category">
      <bpmn:documentation>Business rule task -&gt; DMN decision 'triage-category' (hit policy FIRST). Educational rules only.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-category" resultVariable="triageResult" />
        <zeebe:ioMapping>
        <zeebe:output source="=triageResult" target="triageResult" />
        <zeebe:output source="=triageResult.urgencyCategory" target="urgencyCategory" />
        <zeebe:output source="=triageResult.triageReason" target="triageReason" />
        <zeebe:output source="=triageResult.maxWaitDays" target="maxWaitDays" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Registration_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Triage_Urgent</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_UrgentNeeded" name="Urgent assessment needed?" default="Flow_Urgent_No">
      <bpmn:incoming>Flow_Triage_Urgent</bpmn:incoming>
      <bpmn:outgoing>Flow_Urgent_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Urgent_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PriorityNeeded" name="Priority review needed?" default="Flow_Priority_No">
      <bpmn:incoming>Flow_Urgent_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinPriority">
      <bpmn:incoming>Flow_Priority_No</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Book</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinPriority_JoinUrgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinUrgent">
      <bpmn:incoming>Flow_Assessment_Book</bpmn:incoming>
      <bpmn:incoming>Flow_JoinPriority_JoinUrgent</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinUrgent_Request</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequestAvailability" name="Request appointment availability">
      <bpmn:documentation>Java job worker. Builds the search window (today .. today + maxWaitDays, starting at the preferred date when it lies inside the window) and registers an availability request with the mock scheduling API. Output: availabilityRequestId, searchFromDate, searchToDate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.request-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinUrgent_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Slots</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RetrieveSlots" name="Retrieve available slots" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST Outbound Connector -&gt; GET /mock/scheduling/availability-requests/{id}/slots?site=MAIN_HOSPITAL. No error expression: an outage (HTTP 503) is retried 3x with 5 s back-off and then raises an incident.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="GET" target="method" />
        <zeebe:input source='="http://localhost:8083/mock/scheduling/availability-requests/" + availabilityRequestId + "/slots"' target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="10" target="readTimeoutInSeconds" />
        <zeebe:input source='={site: "MAIN_HOSPITAL"}' target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value='={availableSlots: response.body.slots, slotCount: count(response.body.slots), searchSite: "MAIN_HOSPITAL"}' />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Request_Slots</bpmn:incoming>
      <bpmn:outgoing>Flow_Slots_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SlotAvailable" name="Slot at main hospital?" default="Flow_Slot_No">
      <bpmn:incoming>Flow_Slots_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Slot_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Slot_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinSlotFound">
      <bpmn:incoming>Flow_Slot_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Partner_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinSlotFound_Book</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BookAppointment" name="Book appointment">
      <bpmn:documentation>Java job worker. Books the earliest retrieved slot (main hospital or partner clinic). If every retrieved slot was taken by someone else in the meantime (HTTP 409) it throws BPMN error SLOT_TAKEN. Outputs bookingStatus, bookingReference, appointmentSlot, bookingSite.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.book-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinSlotFound_Book</bpmn:incoming>
      <bpmn:outgoing>Flow_Book_JoinBooked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_SlotTaken" name="Slot taken meanwhile" attachedToRef="Task_BookAppointment">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
        <zeebe:output source="=slotConflicts" target="firstAttemptConflicts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_SlotTaken_Requery</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Boundary_SlotTaken_def" errorRef="Error_SlotTaken" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinBooked">
      <bpmn:incoming>Flow_Book_JoinBooked</bpmn:incoming>
      <bpmn:incoming>Flow_Requeried_JoinBooked</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinBooked_JoinManual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinManualSlot">
      <bpmn:incoming>Flow_Scheduling_Manual</bpmn:incoming>
      <bpmn:incoming>Flow_JoinBooked_JoinManual</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinManual_Ask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_AskConfirmation" name="Ask patient to confirm appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-patient" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="CONFIRMATION_REQUEST" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinManual_Ask</bpmn:incoming>
      <bpmn:outgoing>Flow_Ask_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_WaitForConfirmation" name="Wait for patient confirmation" messageRef="Message_AppointmentConfirmed">
      <bpmn:documentation>Receive task: waits for message 'appointment-confirmed' correlated by patientReference.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
        <zeebe:output source="=&quot;CONFIRMED&quot;" target="patientConfirmation" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ask_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_End</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_ConfirmationReminder" name="Reminder due" attachedToRef="Task_WaitForConfirmation" cancelActivity="false">
      <bpmn:outgoing>Flow_Reminder_Send</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=confirmationReminderAfter</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_ConfirmationTimeout" name="Not confirmed in time" attachedToRef="Task_WaitForConfirmation">
      <bpmn:outgoing>Flow_Timeout_Release</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=confirmationTimeout</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_AppointmentConfirmed" name="Appointment booked and confirmed">
      <bpmn:incoming>Flow_Wait_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RequestMissingDetails" name="Request missing details">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-patient" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="MISSING_DETAILS" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Registration_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Missing_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_RequestIncomplete" name="Request returned – incomplete">
      <bpmn:incoming>Flow_Missing_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SearchPartnerClinic" name="Search partner clinic" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST Outbound Connector -&gt; same availability request, site=PARTNER_CLINIC. Used only when the main hospital has no suitable slot.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="GET" target="method" />
        <zeebe:input source='="http://localhost:8083/mock/scheduling/availability-requests/" + availabilityRequestId + "/slots"' target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="10" target="readTimeoutInSeconds" />
        <zeebe:input source='={site: "PARTNER_CLINIC"}' target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value='={availableSlots: response.body.slots, slotCount: count(response.body.slots), searchSite: "PARTNER_CLINIC"}' />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Slot_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Partner_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PartnerSlot" name="Partner slot available?" default="Flow_Partner_No">
      <bpmn:incoming>Flow_Partner_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Partner_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Partner_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequerySlots" name="Re-query available slots" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST Outbound Connector -&gt; fresh slot list for the same site after a booking conflict.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="GET" target="method" />
        <zeebe:input source='="http://localhost:8083/mock/scheduling/availability-requests/" + availabilityRequestId + "/slots"' target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="10" target="readTimeoutInSeconds" />
        <zeebe:input source="={site: searchSite}" target="queryParameters" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value="={availableSlots: response.body.slots, slotCount: count(response.body.slots), searchSite: searchSite, requeried: true}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotTaken_Requery</bpmn:incoming>
      <bpmn:outgoing>Flow_Requery_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FreeSlotFound" name="Free slot found?" default="Flow_Free_No">
      <bpmn:incoming>Flow_Requery_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Free_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Free_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BookRequeriedSlot" name="Book re-queried slot">
      <bpmn:documentation>Same Java job worker as 'Book appointment' (second and last automatic attempt).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.book-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Free_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Requeried_JoinBooked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_SlotTakenAgain" name="Taken again" attachedToRef="Task_BookRequeriedSlot">
      <bpmn:outgoing>Flow_TakenAgain_Staff</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Boundary_SlotTakenAgain_def" errorRef="Error_SlotTaken" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_SendReminder" name="Send confirmation reminder">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-patient" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="CONFIRMATION_REMINDER" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reminder_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_Reminder_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ReleaseSlot" name="Release appointment slot">
      <bpmn:documentation>Java job worker. Cancels the unconfirmed booking in the scheduling system so the slot becomes free for other patients.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.release-slot" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timeout_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_Release_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyReleased" name="Notify patient: slot released">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-patient" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="SLOT_RELEASED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Release_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Released_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_SlotReleased" name="Slot released – not confirmed">
      <bpmn:incoming>Flow_Released_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_PriorityReview" name="Priority staff review">
      <bpmn:documentation>Camunda user task, candidate group clinical-staff. Form: priority-review-form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="priority-review-form" />
        <zeebe:assignmentDefinition candidateGroups="clinical-staff" />
        <zeebe:priorityDefinition priority="70" />
        <zeebe:ioMapping>
        <zeebe:output source="=reviewOutcome" target="reviewOutcome" />
        <zeebe:output source="=reviewNotes" target="reviewNotes" />
        <zeebe:output source='=if reviewOutcome = "ESCALATE_URGENT" then "URGENT_ASSESSMENT" else urgencyCategory' target="urgencyCategory" />
        <zeebe:output source='=if reviewOutcome = "ESCALATE_URGENT" then 0 else maxWaitDays' target="maxWaitDays" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewOutcome" name="Review outcome?" default="Flow_Review_Book">
      <bpmn:incoming>Flow_Review_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Book</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinAssessment">
      <bpmn:incoming>Flow_Urgent_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinAssessment_Task</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UrgentAssessment" name="Immediate clinical assessment">
      <bpmn:documentation>Camunda user task, candidate group urgent-care-team, highest priority. Form: urgent-assessment-form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="urgent-assessment-form" />
        <zeebe:assignmentDefinition candidateGroups="urgent-care-team" />
        <zeebe:priorityDefinition priority="100" />
        <zeebe:ioMapping>
        <zeebe:output source="=assessmentOutcome" target="assessmentOutcome" />
        <zeebe:output source="=assessmentNotes" target="assessmentNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinAssessment_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_Assessment_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_NotPickedUp" name="Not picked up in time" attachedToRef="Task_UrgentAssessment" cancelActivity="false">
      <bpmn:outgoing>Flow_Timer_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=urgentEscalationAfter</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_AssessmentOutcome" name="Assessment outcome?" default="Flow_Assessment_ED">
      <bpmn:incoming>Flow_Assessment_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Assessment_Book</bpmn:outgoing>
      <bpmn:outgoing>Flow_Assessment_ED</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_HandOverED" name="Hand over to emergency department">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-staff" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="ED_HANDOVER" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Assessment_ED</bpmn:incoming>
      <bpmn:outgoing>Flow_HandOver_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_EmergencyReferral" name="Referred to emergency care">
      <bpmn:incoming>Flow_HandOver_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_EscalateDutyManager" name="Escalate to duty manager">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-staff" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="DUTY_MANAGER_ESCALATION" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_DutyManagerAlerted" name="Duty manager alerted">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinStaffNoSlot">
      <bpmn:incoming>Flow_Partner_No</bpmn:incoming>
      <bpmn:incoming>Flow_Free_No</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinStaffNoSlot_Taken</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinStaffTaken">
      <bpmn:incoming>Flow_TakenAgain_Staff</bpmn:incoming>
      <bpmn:incoming>Flow_JoinStaffNoSlot_Taken</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinStaffTaken_Resolve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ResolveScheduling" name="Resolve scheduling – no suitable slot">
      <bpmn:documentation>Camunda user task, candidate group scheduling-staff. Reached when neither the main hospital nor the partner clinic has a slot, or when the re-queried slot was taken too. Form: scheduling-resolution-form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="scheduling-resolution-form" />
        <zeebe:assignmentDefinition candidateGroups="scheduling-staff" />
        <zeebe:priorityDefinition priority="60" />
        <zeebe:ioMapping>
        <zeebe:output source="=schedulingOutcome" target="schedulingOutcome" />
        <zeebe:output source="=schedulingNotes" target="schedulingNotes" />
        <zeebe:output source="=manualSlot" target="manualSlot" />
        <zeebe:output source='=if schedulingOutcome = "MANUAL_SLOT" then "CONFIRMED_MANUAL" else "WAITLISTED"' target="bookingStatus" />
        <zeebe:output source='=if schedulingOutcome = "MANUAL_SLOT" then manualSlot else null' target="appointmentSlot" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinStaffTaken_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SchedulingOutcome" name="Scheduling outcome?" default="Flow_Scheduling_Waitlist">
      <bpmn:incoming>Flow_Resolve_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Scheduling_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_Scheduling_Waitlist</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyWaitlisted" name="Notify patient: added to waiting list">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage.notify-patient" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="WAITLISTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Scheduling_Waitlist</bpmn:incoming>
      <bpmn:outgoing>Flow_Waitlist_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Waitlisted" name="Patient waitlisted">
      <bpmn:incoming>Flow_Waitlist_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartEvent_RequestReceived" targetRef="Task_ValidateRegistration" />
    <bpmn:sequenceFlow id="Flow_Validate_Gw" sourceRef="Task_ValidateRegistration" targetRef="Gateway_RegistrationComplete" />
    <bpmn:sequenceFlow id="Flow_Registration_Yes" sourceRef="Gateway_RegistrationComplete" targetRef="Task_ClassifyTriage" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Registration_No" sourceRef="Gateway_RegistrationComplete" targetRef="Task_RequestMissingDetails" name="No" />
    <bpmn:sequenceFlow id="Flow_Missing_End" sourceRef="Task_RequestMissingDetails" targetRef="EndEvent_RequestIncomplete" />
    <bpmn:sequenceFlow id="Flow_Triage_Urgent" sourceRef="Task_ClassifyTriage" targetRef="Gateway_UrgentNeeded" />
    <bpmn:sequenceFlow id="Flow_Urgent_Yes" sourceRef="Gateway_UrgentNeeded" targetRef="Gateway_JoinAssessment" name="Yes – urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgencyCategory = "URGENT_ASSESSMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Urgent_No" sourceRef="Gateway_UrgentNeeded" targetRef="Gateway_PriorityNeeded" name="No" />
    <bpmn:sequenceFlow id="Flow_Priority_Yes" sourceRef="Gateway_PriorityNeeded" targetRef="Task_PriorityReview" name="Yes – priority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgencyCategory = "PRIORITY_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority_No" sourceRef="Gateway_PriorityNeeded" targetRef="Gateway_JoinPriority" name="No – routine" />
    <bpmn:sequenceFlow id="Flow_Review_Gw" sourceRef="Task_PriorityReview" targetRef="Gateway_ReviewOutcome" />
    <bpmn:sequenceFlow id="Flow_Review_Book" sourceRef="Gateway_ReviewOutcome" targetRef="Gateway_JoinPriority" name="Book appointment" />
    <bpmn:sequenceFlow id="Flow_Review_Escalate" sourceRef="Gateway_ReviewOutcome" targetRef="Gateway_JoinAssessment" name="Escalate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewOutcome = "ESCALATE_URGENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_JoinAssessment_Task" sourceRef="Gateway_JoinAssessment" targetRef="Task_UrgentAssessment" />
    <bpmn:sequenceFlow id="Flow_Assessment_Gw" sourceRef="Task_UrgentAssessment" targetRef="Gateway_AssessmentOutcome" />
    <bpmn:sequenceFlow id="Flow_Assessment_Book" sourceRef="Gateway_AssessmentOutcome" targetRef="Gateway_JoinUrgent" name="Book urgent slot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=assessmentOutcome = "BOOK_URGENT_SLOT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Assessment_ED" sourceRef="Gateway_AssessmentOutcome" targetRef="Task_HandOverED" name="Emergency referral" />
    <bpmn:sequenceFlow id="Flow_HandOver_End" sourceRef="Task_HandOverED" targetRef="EndEvent_EmergencyReferral" />
    <bpmn:sequenceFlow id="Flow_Timer_Escalate" sourceRef="Boundary_NotPickedUp" targetRef="Task_EscalateDutyManager" />
    <bpmn:sequenceFlow id="Flow_Escalate_End" sourceRef="Task_EscalateDutyManager" targetRef="EndEvent_DutyManagerAlerted" />
    <bpmn:sequenceFlow id="Flow_JoinPriority_JoinUrgent" sourceRef="Gateway_JoinPriority" targetRef="Gateway_JoinUrgent" />
    <bpmn:sequenceFlow id="Flow_JoinUrgent_Request" sourceRef="Gateway_JoinUrgent" targetRef="Task_RequestAvailability" />
    <bpmn:sequenceFlow id="Flow_Request_Slots" sourceRef="Task_RequestAvailability" targetRef="Task_RetrieveSlots" />
    <bpmn:sequenceFlow id="Flow_Slots_Gw" sourceRef="Task_RetrieveSlots" targetRef="Gateway_SlotAvailable" />
    <bpmn:sequenceFlow id="Flow_Slot_Yes" sourceRef="Gateway_SlotAvailable" targetRef="Gateway_JoinSlotFound" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Slot_No" sourceRef="Gateway_SlotAvailable" targetRef="Task_SearchPartnerClinic" name="No" />
    <bpmn:sequenceFlow id="Flow_Partner_Gw" sourceRef="Task_SearchPartnerClinic" targetRef="Gateway_PartnerSlot" />
    <bpmn:sequenceFlow id="Flow_Partner_Yes" sourceRef="Gateway_PartnerSlot" targetRef="Gateway_JoinSlotFound" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Partner_No" sourceRef="Gateway_PartnerSlot" targetRef="Gateway_JoinStaffNoSlot" name="No" />
    <bpmn:sequenceFlow id="Flow_JoinSlotFound_Book" sourceRef="Gateway_JoinSlotFound" targetRef="Task_BookAppointment" />
    <bpmn:sequenceFlow id="Flow_Book_JoinBooked" sourceRef="Task_BookAppointment" targetRef="Gateway_JoinBooked" />
    <bpmn:sequenceFlow id="Flow_SlotTaken_Requery" sourceRef="Boundary_SlotTaken" targetRef="Task_RequerySlots" />
    <bpmn:sequenceFlow id="Flow_Requery_Gw" sourceRef="Task_RequerySlots" targetRef="Gateway_FreeSlotFound" />
    <bpmn:sequenceFlow id="Flow_Free_Yes" sourceRef="Gateway_FreeSlotFound" targetRef="Task_BookRequeriedSlot" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Free_No" sourceRef="Gateway_FreeSlotFound" targetRef="Gateway_JoinStaffNoSlot" name="No" />
    <bpmn:sequenceFlow id="Flow_Requeried_JoinBooked" sourceRef="Task_BookRequeriedSlot" targetRef="Gateway_JoinBooked" />
    <bpmn:sequenceFlow id="Flow_TakenAgain_Staff" sourceRef="Boundary_SlotTakenAgain" targetRef="Gateway_JoinStaffTaken" />
    <bpmn:sequenceFlow id="Flow_JoinStaffNoSlot_Taken" sourceRef="Gateway_JoinStaffNoSlot" targetRef="Gateway_JoinStaffTaken" />
    <bpmn:sequenceFlow id="Flow_JoinStaffTaken_Resolve" sourceRef="Gateway_JoinStaffTaken" targetRef="Task_ResolveScheduling" />
    <bpmn:sequenceFlow id="Flow_Resolve_Gw" sourceRef="Task_ResolveScheduling" targetRef="Gateway_SchedulingOutcome" />
    <bpmn:sequenceFlow id="Flow_Scheduling_Manual" sourceRef="Gateway_SchedulingOutcome" targetRef="Gateway_JoinManualSlot" name="Manual slot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=schedulingOutcome = "MANUAL_SLOT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Scheduling_Waitlist" sourceRef="Gateway_SchedulingOutcome" targetRef="Task_NotifyWaitlisted" name="Waiting list" />
    <bpmn:sequenceFlow id="Flow_Waitlist_End" sourceRef="Task_NotifyWaitlisted" targetRef="EndEvent_Waitlisted" />
    <bpmn:sequenceFlow id="Flow_JoinBooked_JoinManual" sourceRef="Gateway_JoinBooked" targetRef="Gateway_JoinManualSlot" />
    <bpmn:sequenceFlow id="Flow_JoinManual_Ask" sourceRef="Gateway_JoinManualSlot" targetRef="Task_AskConfirmation" />
    <bpmn:sequenceFlow id="Flow_Ask_Wait" sourceRef="Task_AskConfirmation" targetRef="Task_WaitForConfirmation" />
    <bpmn:sequenceFlow id="Flow_Wait_End" sourceRef="Task_WaitForConfirmation" targetRef="EndEvent_AppointmentConfirmed" />
    <bpmn:sequenceFlow id="Flow_Reminder_Send" sourceRef="Boundary_ConfirmationReminder" targetRef="Task_SendReminder" />
    <bpmn:sequenceFlow id="Flow_Reminder_End" sourceRef="Task_SendReminder" targetRef="EndEvent_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_Timeout_Release" sourceRef="Boundary_ConfirmationTimeout" targetRef="Task_ReleaseSlot" />
    <bpmn:sequenceFlow id="Flow_Release_Notify" sourceRef="Task_ReleaseSlot" targetRef="Task_NotifyReleased" />
    <bpmn:sequenceFlow id="Flow_Released_End" sourceRef="Task_NotifyReleased" targetRef="EndEvent_SlotReleased" />
    <bpmn:textAnnotation id="Annotation_DmnRules">
      <bpmn:text>DMN triage-category (FIRST hit):
• chest pain / breathing difficulty / pain ≥ 8 → Urgent
• high fever and age ≥ 65 → Priority review
• pain 5–7 or symptoms &gt; 14 days → Priority review
• otherwise → Routine (max wait 14 days)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Disclaimer">
      <bpmn:text>Educational rules only – not clinical guidance.
All patient data is synthetic (SYN-P-####).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_SchedulingOutage">
      <bpmn:text>Scheduling API outage (HTTP 503)
→ 3 retries, 5 s back-off
→ incident in Operate → fix → retry</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Fallbacks">
      <bpmn:text>Fallbacks before a human is involved:
1. main hospital full → partner clinic
2. slot taken while booking → re-query once
3. still nothing → scheduling staff</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Timers">
      <bpmn:text>Timer durations are process variables
(defaults: escalation 15 min, reminder 12 h,
confirmation timeout 24 h)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Legend">
      <bpmn:text>Legend
green task = Java job worker
blue task = REST connector
purple task = DMN decision
orange task = human task (Tasklist)
teal task = waiting for the patient
grey task = notification</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:error id="Error_SlotTaken" name="Slot taken while booking" errorCode="SLOT_TAKEN" />
  <bpmn:message id="Message_AppointmentConfirmed" name="appointment-confirmed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientReference" />
    </bpmn:extensionElements>
  </bpmn:message>

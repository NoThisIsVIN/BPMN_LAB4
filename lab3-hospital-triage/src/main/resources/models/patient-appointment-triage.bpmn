        <dc:Bounds x="1465" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinUrgent_di" bpmnElement="Gateway_JoinUrgent" isMarkerVisible="true">
        <dc:Bounds x="1615" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestAvailability_di" bpmnElement="Task_RequestAvailability" bioc:stroke="#2e7d32" bioc:fill="#e8f5e9" color:background-color="#e8f5e9" color:border-color="#2e7d32">
        <dc:Bounds x="1740" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveSlots_di" bpmnElement="Task_RetrieveSlots" bioc:stroke="#1565c0" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#1565c0">
        <dc:Bounds x="1890" y="340" width="100" height="80" />

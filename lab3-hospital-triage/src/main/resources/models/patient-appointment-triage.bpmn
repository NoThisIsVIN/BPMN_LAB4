        <dc:Bounds x="2065" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2040" y="411" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinSlotFound_di" bpmnElement="Gateway_JoinSlotFound" isMarkerVisible="true">
        <dc:Bounds x="2515" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BookAppointment_di" bpmnElement="Task_BookAppointment" bioc:stroke="#2e7d32" bioc:fill="#e8f5e9" color:background-color="#e8f5e9" color:border-color="#2e7d32">
        <dc:Bounds x="2640" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_SlotTaken_di" bpmnElement="Boundary_SlotTaken" bioc:stroke="#c62828" bioc:fill="#ffffff" color:background-color="#ffffff" color:border-color="#c62828">
        <dc:Bounds x="2672" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2596" y="312" width="70" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinBooked_di" bpmnElement="Gateway_JoinBooked" isMarkerVisible="true">
        <dc:Bounds x="3265" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinManualSlot_di" bpmnElement="Gateway_JoinManualSlot" isMarkerVisible="true">
        <dc:Bounds x="3415" y="355" width="50" height="50" />

{
  "id": "L1-08",
  "title": "Validation worker dependency down -> incident -> repaired -> retried -> approved",
  "category": "failure-recovery",
  "processId": "loan-approval",
  "app": "http://localhost:8081",
  "expected": {
    "endEvent": "EndEvent_LoanApproved",
    "route": "Validate fails 3x (5 s back-off) -> INCIDENT -> fault switched off -> job retried -> Loan approved"
  },
  "variables": {
    "applicationId": "LA-2026-0008",
    "applicantId": "APP-1005",
    "fullName": "Synthetic Applicant Hotel",
    "email": "synthetic.applicant.hotel@example.org",
    "age": 35,
    "employmentStatus": "EMPLOYED",
    "monthlyIncome": 7000,
    "monthlyDebtPayments": 200,
    "loanAmount": 20000,
    "loanTermMonths": 48,
    "loanPurpose": "Home renovation"
  },
  "steps": [
    {
      "do": "fault",
      "name": "validation-reference-data",
      "enabled": true,
      "before": true
    },
    {
      "do": "expectIncident",
      "elementId": "Task_ValidateApplicant"
    },
    {
      "do": "screenshot",
      "view": "operate-instance",
      "name": "07-operate-incident-L1-08"
    },
    {
      "do": "screenshot",
      "view": "operate-incident",
      "name": "08-operate-incident-detail-L1-08"
    },
    {
      "do": "screenshot",
      "view": "operate-incident-message",
      "name": "08-operate-incident-message-L1-08"
    },
    {
      "do": "fault",
      "name": "validation-reference-data",
      "enabled": false
    },
    {
      "do": "retryIncident"
    },
    {
      "do": "wait"
    },
    {
      "do": "screenshot",
      "view": "operate-instance",
      "name": "09-operate-recovered-L1-08"
    }
  ],
  "reportVariables": [

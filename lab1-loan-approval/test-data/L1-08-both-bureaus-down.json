{
  "id": "L1-08",
  "title": "Both credit bureaus down -> loan officer decides without a score -> approves",
  "category": "fallback",
  "processId": "loan-approval",
  "app": "http://localhost:8081",
  "expected": {
    "endEvent": "EndEvent_LoanDisbursed",
    "route": "primary 503 -> backup 503 -> CREDIT_API_ERROR -> manual review without score -> approve -> accepted -> disbursed"
  },
  "variables": {

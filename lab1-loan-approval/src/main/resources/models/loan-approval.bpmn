<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_loan-approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_loan-approval">
    <bpmn:participant id="Participant_loan-approval" name="Loan Approval – Bank (educational scenario)" processRef="loan-approval" />
  </bpmn:collaboration>
  <bpmn:process id="loan-approval" name="Loan Approval" isExecutable="true">
    <bpmn:documentation>End-to-end loan approval with recovery paths: incomplete applications are sent back for correction, identity is verified, the credit score falls back to a backup bureau, an overdue review escalates to a senior officer, and the offer must be accepted before disbursement. Synthetic data only.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.0.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_loan-approval">
      <bpmn:lane id="Lane_Applicant" name="Applicant correspondence">
        <bpmn:flowNodeRef>Task_RequestMissingInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CorrectionTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ApplicationClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LoanSystem" name="Loan system (automated)">
        <bpmn:flowNodeRef>StartEvent_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateApplicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyIdentity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IdentityVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_PrimaryBureauDown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinScore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoanDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinSenior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LoanApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForOfferResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_OfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LoanDisbursed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinEarlyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinDmnRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LoanRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OfferDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditAssessmentBackup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CreditApiError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyOfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OfferExpired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LoanOfficer" name="Loan officers">
        <bpmn:flowNodeRef>Gateway_JoinReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReviewEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReviewOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemindOfficers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeniorReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="Loan application received">
      <bpmn:documentation>Variables: applicationId, applicantId, fullName, email, age, employmentStatus, monthlyIncome, monthlyDebtPayments, loanAmount, loanTermMonths, loanPurpose (+ optional timer overrides).</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Join</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinCorrection">
      <bpmn:incoming>Flow_Start_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Corrected_Revalidate</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Validate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ValidateApplicant" name="Validate applicant data">
      <bpmn:documentation>Java worker. Completeness (missing / malformed fields -&gt; correctable) and eligibility (age, amount, term, income -&gt; not correctable). Computes instalment, DTI and LTI; sets timer defaults.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.validate-applicant" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataComplete" name="Application complete?" default="Flow_Complete_No">
      <bpmn:incoming>Flow_Validate_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Applicant eligible?" default="Flow_Eligible_No">
      <bpmn:incoming>Flow_Complete_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyIdentity" name="Verify identity (KYC)">
      <bpmn:documentation>Java worker. Synthetic KYC check (document + watch-list). Outputs identityVerified, kycReference.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.verify-identity" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Eligible_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Identity_Check</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_IdentityVerified" name="Identity verified?" default="Flow_Identity_No">
      <bpmn:incoming>Flow_Identity_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Identity_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Identity_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreditAssessment" name="Request credit score – primary bureau" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST connector -&gt; primary bureau (CIBIL-like). HTTP error or 5 s timeout -&gt; BPMN error PRIMARY_BUREAU_DOWN -&gt; backup bureau.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="POST" target="method" />
        <zeebe:input source="http://localhost:8081/mock/credit-bureau/primary/assessments" target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="5" target="readTimeoutInSeconds" />
        <zeebe:input source="={applicationId: applicationId, applicantId: applicantId, fullName: fullName, monthlyIncome: monthlyIncome, monthlyDebtPayments: monthlyDebtPayments, loanAmount: loanAmount}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value='={creditCheckStatus: "COMPLETED", creditBureauUsed: "PRIMARY", creditScore: response.body.creditScore, creditRiskBand: response.body.riskBand, creditBureauReference: response.body.bureauReference, activeCreditAccounts: response.body.activeCreditAccounts}' />
        <zeebe:header key="errorExpression" value='=if error != null then bpmnError("PRIMARY_BUREAU_DOWN", "Credit bureau call failed", {primaryBureauError: "HTTP " + string(error.code) + ": " + (if error.variables.response.body.error != null then string(error.variables.response.body.error) else string(error.message))}) else null' />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Identity_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Primary_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_PrimaryBureauDown" name="Primary bureau unavailable" attachedToRef="Task_CreditAssessment">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
        <zeebe:output source="=primaryBureauError" target="primaryBureauError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_PrimaryDown_Backup</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Error_PrimaryBureauDown_def" errorRef="Error_PrimaryBureauDown" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinScore">
      <bpmn:incoming>Flow_Primary_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Backup_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Decision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_LoanDecision" name="Determine loan decision">
      <bpmn:documentation>Business rule task -&gt; DMN 'loan-decision' (hit policy FIRST).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loan-decision" resultVariable="loanDecision" />
        <zeebe:ioMapping>
        <zeebe:output source="=loanDecision" target="loanDecision" />
        <zeebe:output source="=loanDecision.outcome" target="finalDecision" />
        <zeebe:output source="=loanDecision.reason" target="decisionReason" />
        <zeebe:output source='="AUTOMATED (DMN)"' target="decisionSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Gw</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_DecisionOutcome" name="Decision outcome?" default="Flow_Outcome_Manual">
      <bpmn:incoming>Flow_Decision_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Outcome_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinApproval">
      <bpmn:incoming>Flow_Outcome_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_Review_JoinApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinApproval_JoinSenior</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinSenior">
      <bpmn:incoming>Flow_Senior_Join</bpmn:incoming>
      <bpmn:incoming>Flow_JoinApproval_JoinSenior</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinSenior_Gw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_LoanApproved" name="Loan approved?" default="Flow_Approved_No">
      <bpmn:incoming>Flow_JoinSenior_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateOffer" name="Generate loan offer">
      <bpmn:documentation>Java worker. Rate from the credit risk band; offerId, offerMonthlyInstallment, offerValidUntil.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.generate-offer" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Offer_Send</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendOffer" name="Send loan offer to applicant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.notify-applicant" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="LOAN_OFFER" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Offer_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_Send_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_WaitForOfferResponse" name="Wait for offer acceptance" messageRef="Message_OfferResponse">
      <bpmn:documentation>Message 'loan-offer-response' (correlation key applicationId) carrying offerAccepted true/false.</bpmn:documentation>
      <bpmn:incoming>Flow_Send_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Accepted</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_OfferExpired" name="Offer not answered in time" attachedToRef="Task_WaitForOfferResponse">
      <bpmn:outgoing>Flow_OfferExpired_Notify</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=offerAcceptanceTimeout</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_OfferAccepted" name="Offer accepted?" default="Flow_Accepted_No">
      <bpmn:incoming>Flow_Wait_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accepted_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Disburse" name="Disburse loan">
      <bpmn:documentation>Java worker. Synthetic payout: disbursementReference, disbursedAt.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.disburse" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accepted_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Disburse_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_LoanDisbursed" name="Loan disbursed">
      <bpmn:incoming>Flow_Disburse_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinEarlyRejection">
      <bpmn:incoming>Flow_Eligible_No</bpmn:incoming>
      <bpmn:incoming>Flow_Identity_No</bpmn:incoming>
      <bpmn:outgoing>Flow_EarlyRejection_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinDmnRejection">
      <bpmn:incoming>Flow_Outcome_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_EarlyRejection_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_DmnRejection_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinRejection">
      <bpmn:incoming>Flow_DmnRejection_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Approved_No</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinRejection_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyRejected" name="Send rejection notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.notify-applicant" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="LOAN_REJECTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinRejection_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyRejected_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_LoanRejected" name="Loan rejected">
      <bpmn:incoming>Flow_NotifyRejected_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_OfferDeclined" name="Offer declined by applicant">
      <bpmn:incoming>Flow_Accepted_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreditAssessmentBackup" name="Request credit score – backup bureau" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST connector -&gt; backup bureau (second provider). Used only when the primary bureau fails. If it fails too -&gt; BPMN error CREDIT_API_ERROR -&gt; loan officer decides without a score.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="POST" target="method" />
        <zeebe:input source="http://localhost:8081/mock/credit-bureau/backup/assessments" target="url" />
        <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="5" target="readTimeoutInSeconds" />
        <zeebe:input source="={applicationId: applicationId, applicantId: applicantId, fullName: fullName, monthlyIncome: monthlyIncome, monthlyDebtPayments: monthlyDebtPayments, loanAmount: loanAmount}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="retryBackoff" value="PT5S" />
        <zeebe:header key="resultExpression" value='={creditCheckStatus: "COMPLETED", creditBureauUsed: "BACKUP", creditScore: response.body.creditScore, creditRiskBand: response.body.riskBand, creditBureauReference: response.body.bureauReference, activeCreditAccounts: response.body.activeCreditAccounts}' />
        <zeebe:header key="errorExpression" value='=if error != null then bpmnError("CREDIT_API_ERROR", "Credit bureau call failed", {creditCheckError: "HTTP " + string(error.code) + ": " + (if error.variables.response.body.error != null then string(error.variables.response.body.error) else string(error.message))}) else null' />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrimaryDown_Backup</bpmn:incoming>
      <bpmn:outgoing>Flow_Backup_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CreditApiError" name="Both bureaus unavailable" attachedToRef="Task_CreditAssessmentBackup">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
        <zeebe:output source="=&quot;UNAVAILABLE&quot;" target="creditCheckStatus" />
        <zeebe:output source="=creditCheckError" target="creditCheckError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BothDown_Review</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Error_CreditApi_def" errorRef="Error_CreditApi" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_NotifyOfferExpired" name="Notify applicant: offer expired">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.notify-applicant" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="OFFER_EXPIRED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OfferExpired_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyExpired_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_OfferExpired" name="Offer expired">
      <bpmn:incoming>Flow_NotifyExpired_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RequestMissingInfo" name="Request missing information">
      <bpmn:documentation>Tells the applicant which fields are missing or invalid (validationErrors).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.notify-applicant" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="MISSING_INFORMATION" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_WaitForCorrection" name="Wait for corrected details" messageRef="Message_CorrectedDetails">
      <bpmn:documentation>Message 'corrected-details-received' (correlation key applicationId) with the corrected fields; the application is validated again.</bpmn:documentation>
      <bpmn:incoming>Flow_Request_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Corrected_Revalidate</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_CorrectionTimeout" name="No reply in time" attachedToRef="Task_WaitForCorrection">
      <bpmn:outgoing>Flow_CorrectionTimeout_Notify</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=correctionTimeout</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_NotifyClosed" name="Notify applicant: application closed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.notify-applicant" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="APPLICATION_CLOSED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CorrectionTimeout_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyClosed_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ApplicationClosed" name="Application closed – no reply">
      <bpmn:incoming>Flow_NotifyClosed_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinReview">
      <bpmn:incoming>Flow_BothDown_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Outcome_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinReview_Task</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualReview" name="Review loan application">
      <bpmn:documentation>Camunda user task (Tasklist), candidate group loan-officers. Form: loan-review-form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="loan-review-form" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        <zeebe:priorityDefinition priority="70" />
        <zeebe:ioMapping>
        <zeebe:output source="=officerDecision" target="officerDecision" />
        <zeebe:output source="=officerComment" target="officerComment" />
        <zeebe:output source="=officerDecision" target="finalDecision" />
        <zeebe:output source="=officerComment" target="decisionReason" />
        <zeebe:output source='="LOAN OFFICER"' target="decisionSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinReview_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_JoinApproval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ReviewEscalation" name="Not decided in 48 h" attachedToRef="Task_ManualReview">
      <bpmn:outgoing>Flow_Escalate_Senior</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=reviewEscalationAfter</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_ReviewOverdue" name="Pending 24 h" attachedToRef="Task_ManualReview" cancelActivity="false">
      <bpmn:outgoing>Flow_Overdue_Remind</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=reviewReminderAfter</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_RemindOfficers" name="Send reminder to loan officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan.notify-officers" retries="3" />
        <zeebe:taskHeaders>
        <zeebe:header key="template" value="REVIEW_OVERDUE" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Overdue_Remind</bpmn:incoming>
      <bpmn:outgoing>Flow_Remind_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_Remind_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_SeniorReview" name="Review by senior officer">
      <bpmn:documentation>Escalation after the review SLA: candidate group senior-loan-officers, same form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="loan-review-form" />
        <zeebe:assignmentDefinition candidateGroups="senior-loan-officers" />
        <zeebe:priorityDefinition priority="90" />
        <zeebe:ioMapping>
        <zeebe:output source="=officerDecision" target="officerDecision" />
        <zeebe:output source="=officerComment" target="officerComment" />
        <zeebe:output source="=officerDecision" target="finalDecision" />
        <zeebe:output source="=officerComment" target="decisionReason" />
        <zeebe:output source='="SENIOR LOAN OFFICER (escalated)"' target="decisionSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escalate_Senior</bpmn:incoming>
      <bpmn:outgoing>Flow_Senior_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Start_Join" sourceRef="StartEvent_ApplicationReceived" targetRef="Gateway_JoinCorrection" />
    <bpmn:sequenceFlow id="Flow_Join_Validate" sourceRef="Gateway_JoinCorrection" targetRef="Task_ValidateApplicant" />
    <bpmn:sequenceFlow id="Flow_Validate_Complete" sourceRef="Task_ValidateApplicant" targetRef="Gateway_DataComplete" />
    <bpmn:sequenceFlow id="Flow_Complete_Yes" sourceRef="Gateway_DataComplete" targetRef="Gateway_Eligible" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=applicationComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Complete_No" sourceRef="Gateway_DataComplete" targetRef="Task_RequestMissingInfo" name="No – details missing" />
    <bpmn:sequenceFlow id="Flow_Request_Wait" sourceRef="Task_RequestMissingInfo" targetRef="Task_WaitForCorrection" />
    <bpmn:sequenceFlow id="Flow_Corrected_Revalidate" sourceRef="Task_WaitForCorrection" targetRef="Gateway_JoinCorrection" name="Corrected details received" />
    <bpmn:sequenceFlow id="Flow_CorrectionTimeout_Notify" sourceRef="Boundary_CorrectionTimeout" targetRef="Task_NotifyClosed" />
    <bpmn:sequenceFlow id="Flow_NotifyClosed_End" sourceRef="Task_NotifyClosed" targetRef="EndEvent_ApplicationClosed" />
    <bpmn:sequenceFlow id="Flow_Eligible_Yes" sourceRef="Gateway_Eligible" targetRef="Task_VerifyIdentity" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=applicantEligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eligible_No" sourceRef="Gateway_Eligible" targetRef="Gateway_JoinEarlyRejection" name="No" />
    <bpmn:sequenceFlow id="Flow_Identity_Check" sourceRef="Task_VerifyIdentity" targetRef="Gateway_IdentityVerified" />
    <bpmn:sequenceFlow id="Flow_Identity_Yes" sourceRef="Gateway_IdentityVerified" targetRef="Task_CreditAssessment" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=identityVerified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Identity_No" sourceRef="Gateway_IdentityVerified" targetRef="Gateway_JoinEarlyRejection" name="No" />
    <bpmn:sequenceFlow id="Flow_Primary_Join" sourceRef="Task_CreditAssessment" targetRef="Gateway_JoinScore" name="Score received" />
    <bpmn:sequenceFlow id="Flow_PrimaryDown_Backup" sourceRef="Boundary_PrimaryBureauDown" targetRef="Task_CreditAssessmentBackup" />
    <bpmn:sequenceFlow id="Flow_Backup_Join" sourceRef="Task_CreditAssessmentBackup" targetRef="Gateway_JoinScore" />
    <bpmn:sequenceFlow id="Flow_BothDown_Review" sourceRef="Boundary_CreditApiError" targetRef="Gateway_JoinReview" />
    <bpmn:sequenceFlow id="Flow_Join_Decision" sourceRef="Gateway_JoinScore" targetRef="Task_LoanDecision" />
    <bpmn:sequenceFlow id="Flow_Decision_Gw" sourceRef="Task_LoanDecision" targetRef="Gateway_DecisionOutcome" />
    <bpmn:sequenceFlow id="Flow_Outcome_Approved" sourceRef="Gateway_DecisionOutcome" targetRef="Gateway_JoinApproval" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision.outcome = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Outcome_Rejected" sourceRef="Gateway_DecisionOutcome" targetRef="Gateway_JoinDmnRejection" name="Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision.outcome = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Outcome_Manual" sourceRef="Gateway_DecisionOutcome" targetRef="Gateway_JoinReview" name="Manual review" />
    <bpmn:sequenceFlow id="Flow_EarlyRejection_Join" sourceRef="Gateway_JoinEarlyRejection" targetRef="Gateway_JoinDmnRejection" />
    <bpmn:sequenceFlow id="Flow_DmnRejection_Join" sourceRef="Gateway_JoinDmnRejection" targetRef="Gateway_JoinRejection" />
    <bpmn:sequenceFlow id="Flow_JoinReview_Task" sourceRef="Gateway_JoinReview" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_Review_JoinApproval" sourceRef="Task_ManualReview" targetRef="Gateway_JoinApproval" name="Decided" />
    <bpmn:sequenceFlow id="Flow_Overdue_Remind" sourceRef="Boundary_ReviewOverdue" targetRef="Task_RemindOfficers" />
    <bpmn:sequenceFlow id="Flow_Remind_End" sourceRef="Task_RemindOfficers" targetRef="EndEvent_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_Escalate_Senior" sourceRef="Boundary_ReviewEscalation" targetRef="Task_SeniorReview" />
    <bpmn:sequenceFlow id="Flow_Senior_Join" sourceRef="Task_SeniorReview" targetRef="Gateway_JoinSenior" />
    <bpmn:sequenceFlow id="Flow_JoinApproval_JoinSenior" sourceRef="Gateway_JoinApproval" targetRef="Gateway_JoinSenior" />
    <bpmn:sequenceFlow id="Flow_JoinSenior_Gw" sourceRef="Gateway_JoinSenior" targetRef="Gateway_LoanApproved" />
    <bpmn:sequenceFlow id="Flow_Approved_Yes" sourceRef="Gateway_LoanApproved" targetRef="Task_GenerateOffer" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved_No" sourceRef="Gateway_LoanApproved" targetRef="Gateway_JoinRejection" name="No" />
    <bpmn:sequenceFlow id="Flow_JoinRejection_Notify" sourceRef="Gateway_JoinRejection" targetRef="Task_NotifyRejected" />
    <bpmn:sequenceFlow id="Flow_NotifyRejected_End" sourceRef="Task_NotifyRejected" targetRef="EndEvent_LoanRejected" />
    <bpmn:sequenceFlow id="Flow_Offer_Send" sourceRef="Task_GenerateOffer" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="Flow_Send_Wait" sourceRef="Task_SendOffer" targetRef="Task_WaitForOfferResponse" />
    <bpmn:sequenceFlow id="Flow_Wait_Accepted" sourceRef="Task_WaitForOfferResponse" targetRef="Gateway_OfferAccepted" />
    <bpmn:sequenceFlow id="Flow_OfferExpired_Notify" sourceRef="Boundary_OfferExpired" targetRef="Task_NotifyOfferExpired" />
    <bpmn:sequenceFlow id="Flow_NotifyExpired_End" sourceRef="Task_NotifyOfferExpired" targetRef="EndEvent_OfferExpired" />
    <bpmn:sequenceFlow id="Flow_Accepted_Yes" sourceRef="Gateway_OfferAccepted" targetRef="Task_Disburse" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=offerAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Accepted_No" sourceRef="Gateway_OfferAccepted" targetRef="EndEvent_OfferDeclined" name="No" />
    <bpmn:sequenceFlow id="Flow_Disburse_End" sourceRef="Task_Disburse" targetRef="EndEvent_LoanDisbursed" />
    <bpmn:textAnnotation id="Annotation_Bureaus">
      <bpmn:text>Credit score fallback:
primary bureau fails (HTTP error / 5 s timeout)
→ backup bureau (second provider)
→ both fail → officer decides without score</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Timers">
      <bpmn:text>Timers read their duration from variables
(defaults set by the validation worker):
correction 7 days · reminder 24 h · escalation 48 h · offer 14 days</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_DmnRules">
      <bpmn:text>DMN loan-decision (FIRST hit):
• score &lt; 550 or DTI &gt; 50% or unemployed → Rejected
• amount &gt; 100 000 → Manual review
• score ≥ 700, DTI ≤ 35%, LTI ≤ 0.5 → Approved
• otherwise → Manual review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Legend">
      <bpmn:text>Legend
green task = Java job worker
blue task = REST connector
purple task = DMN decision
orange task = human task (Tasklist)
teal task = waiting for the applicant
grey task = notification</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Rejections">
      <bpmn:text>All rejections (not eligible, identity, DMN, officer)
share one track and one notice</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:error id="Error_PrimaryBureauDown" name="Primary credit bureau unavailable" errorCode="PRIMARY_BUREAU_DOWN" />
  <bpmn:error id="Error_CreditApi" name="No credit bureau available" errorCode="CREDIT_API_ERROR" />
  <bpmn:message id="Message_CorrectedDetails" name="corrected-details-received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_OfferResponse" name="loan-offer-response">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
